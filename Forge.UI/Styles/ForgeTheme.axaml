<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <Color x:Key="ForgeBackgroundColor">#F5F1E8</Color>
        <Color x:Key="ForgeTextColor">#121212</Color>
        <Color x:Key="ForgeMutedColor">#6B665F</Color>
        <Color x:Key="ForgeCardBgColor">#ECE7DC</Color>
        <Color x:Key="ForgeBorderColor">#DCD4C6</Color>
        <Color x:Key="ForgeIronColor">#1E1D1A</Color>
        <Color x:Key="ForgeGoldColor">#996515</Color>

        <SolidColorBrush x:Key="ForgeBackgroundBrush" Color="{StaticResource ForgeBackgroundColor}" />
        <SolidColorBrush x:Key="ForgeTextBrush" Color="{StaticResource ForgeTextColor}" />
        <SolidColorBrush x:Key="ForgeMutedBrush" Color="{StaticResource ForgeMutedColor}" />
        <SolidColorBrush x:Key="ForgeCardBgBrush" Color="{StaticResource ForgeCardBgColor}" />
        <SolidColorBrush x:Key="ForgeBorderBrush" Color="{StaticResource ForgeBorderColor}" />
        <SolidColorBrush x:Key="ForgeIronBrush" Color="{StaticResource ForgeIronColor}" />
        <SolidColorBrush x:Key="ForgeGoldBrush" Color="{StaticResource ForgeGoldColor}" />
    </Styles.Resources>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ForgeTextBrush}" />
    </Style>

    <Style Selector="Button.forge-button">
        <Setter Property="Background" Value="{StaticResource ForgeIronBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ForgeBackgroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.forge-card">
        <Setter Property="Background" Value="{StaticResource ForgeCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ForgeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

</Styles>
