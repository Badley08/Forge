<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <TargetPlatformVersion>37</TargetPlatformVersion>
    <ApplicationId>com.karlitodev.forge</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Release-only: R8 shrinking, obfuscation and signing via CI secrets -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <EnableProguard>true</EnableProguard>
    <AndroidEnableProguardMappingFile>true</AndroidEnableProguardMappingFile>
    <AndroidSigningKeyStore>$(KeystorePath)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>$(KeystoreAlias)</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(KeystoreKeyPass)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(KeystoreStorePass)</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <ProguardConfiguration Include="proguard-rules.pro" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.2.1" />
    <PackageReference Include="Plugin.InAppBilling" Version="7.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Forge.UI\Forge.UI.csproj" />
    <ProjectReference Include="..\Forge.Core\Forge.Core.csproj" />
    <ProjectReference Include="..\Forge.Data\Forge.Data.csproj" />
  </ItemGroup>

</Project>
